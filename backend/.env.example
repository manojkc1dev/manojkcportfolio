# ============================================================================
# Django REST API Environment Configuration
# ============================================================================

# Django Core Settings
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-cryptographically-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api.manojkc1.com.np

# PostgreSQL Database Configuration
# You can provide a full DATABASE_URL or individual PG credentials
# Example: postgres://portfolio_user:secure_password@localhost:5432/portfolio_db
DATABASE_URL=
# Individual parameters (used if DATABASE_URL is not set)
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS Whitelist Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://manojkc1.com.np

# Static & Media Hosting (Optional Cloud Storage)
STATIC_URL=/static/
MEDIA_URL=/media/

# Security Settings (Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
