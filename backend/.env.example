# ============================================================================
# Django REST API Environment Configuration
# ============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.

# ── Django Core ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=core.settings.development

# REQUIRED IN PRODUCTION: generate with `openssl rand -base64 50`
# Leave as-is ONLY for local development; production startup will fail fast
# if this placeholder or an empty value is detected.
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-cryptographically-secure-random-secret-key

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Provide DATABASE_URL or individual PG credentials (DATABASE_URL takes priority)
# Example: postgres://portfolio_user:secure_password@localhost:5432/portfolio_db
DATABASE_URL=
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://manojkc1.com.np
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://manojkc1.com.np,https://*.manojkc1.com.np

# ── Gunicorn WSGI / Process Configuration ────────────────────────────────────
# Port to bind (Render / Heroku automatically inject $PORT)
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOGLEVEL=info

# ── Static & Media Storage ───────────────────────────────────────────────────
STATIC_URL=/static/
MEDIA_URL=/media/
WHITENOISE_MAX_AGE=3600

# ── Frontend URL (used for password reset links) ─────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# In development, leave EMAIL_HOST_USER blank to use the console backend.
# In production, configure real SMTP credentials.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Manoj Khatri <contact@manojkc1.com.np>
ADMIN_LOGIN_EMAIL=contactmanojkc1.com.np@gmail.com
PASSWORD_RESET_TIMEOUT=86400

# ── SSL & Reverse Proxy (Production Overrides) ────────────────────────────────
# Behind a reverse proxy (Render, Nginx, Cloudflare), set SECURE_PROXY_SSL_HEADER=True
# so Django accurately identifies HTTPS requests via X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER=True

# Set SECURE_SSL_REDIRECT=False here ONLY if your local environment does not
# use HTTPS. In production this should be True (or handled by the proxy).
SECURE_SSL_REDIRECT=False

# HSTS duration in seconds (production.py default: 31536000 = 1 year).
# Set to 0 ONLY during a planned HTTP→HTTPS migration window.
# SECURE_HSTS_SECONDS=31536000
