# ============================================================================
# Frontend Environment Configuration (React + Vite)
# ============================================================================
# For Render deployment, configure these in your Render Static Site dashboard:

# Backend Django REST API Base URL
# Local development: http://127.0.0.1:8000
# Render Staging:     https://manojkc-portfolio-api.onrender.com
# Production:         https://api.manojkc1.com.np
VITE_DJANGO_API_URL=https://api.manojkc1.com.np
VITE_API_URL=https://api.manojkc1.com.np

# Canonical Frontend URL
# Local development: http://localhost:3000
# Render Staging:     https://manojkc-portfolio.onrender.com
# Production:         https://manojkc1.com.np
VITE_SITE_URL=https://manojkc1.com.np

# Optional Analytics
VITE_ENABLE_ANALYTICS=false
