# Firebase Configuration (Supported via VITE_FB_* or standard VITE_FIREBASE_*)
# Enable Email/Password Provider in Firebase Console -> Build -> Authentication -> Sign-in method
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=manojkc1-portfolio.firebaseapp.com
VITE_FB_PROJECT_ID=manojkc1-portfolio
VITE_FB_STORAGE_BUCKET=manojkc1-portfolio.appspot.com
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
VITE_FB_MEASUREMENT_ID=

# Alternative Firebase environment variable naming (also recognized)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
