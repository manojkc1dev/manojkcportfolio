rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /resume/{allPaths=**} {
      allow read, write: if false;  // served via Cloud Function only
    }
    match /case-studies/{allPaths=**} {
      allow read, write: if false;  // served via Cloud Function only
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
